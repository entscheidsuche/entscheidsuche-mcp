# Such-API von entscheidsuche.ch (derselbe Proxy, den die Web-Oberfläche nutzt).
# Darunter liegen alle Endpunkte der Stichwort- und der KI-Suche:
#   <BASE>/elasticsearch/_search                                        Entscheide
#   <BASE>/elasticsearch/embeddings_qwen3-embedding-8b/_search          Textabschnitte
#   <BASE>/elasticsearch/embeddings_qwen3-embedding-0.6b_micro/_search  Micro-Chunks
#   <BASE>/embed/big, <BASE>/embed/micro                                Embeddings
#   <BASE>/indexMicroChunk                                              Nachindexierung
ENTSCHEIDSUCHE_API_BASE=https://entscheidsuche.ch/_search_KI.php

# Einzelne Endpunkte lassen sich bei Bedarf überschreiben (sonst weglassen):
# ENTSCHEIDSUCHE_ES_URL=
# ENTSCHEIDSUCHE_CHUNK_SEARCH_URL=
# ENTSCHEIDSUCHE_MICRO_CHUNK_SEARCH_URL=
# ENTSCHEIDSUCHE_EMBED_BIG_URL=
# ENTSCHEIDSUCHE_EMBED_BIG_MODEL=qwen3-embedding-8b
# ENTSCHEIDSUCHE_EMBED_MICRO_URL=
# ENTSCHEIDSUCHE_EMBED_MICRO_MODEL=qwen3-embedding-0.6b
# ENTSCHEIDSUCHE_INDEX_MICRO_CHUNK_URL=

# KI-Suche (semantic_search) ein-/ausschalten. Bei false führt auch das Tool
# `search` die Stichwortsuche aus.
ENTSCHEIDSUCHE_SEMANTIC_SEARCH=true

# Fehlt für einen Treffer der KI-Suche der Auszug (Micro-Chunks noch nicht
# indexiert), wird die Indexierung angestossen. So viele Sekunden wartet der
# Aufruf darauf höchstens; danach kommt der Treffer ohne Auszug.
ENTSCHEIDSUCHE_MICRO_CHUNK_WAIT=20

# Der Such-Endpunkt läuft über alle Indizes; Abfragen auf die Entscheide werden
# auf Indizes mit diesem Präfix eingeschränkt.
# ENTSCHEIDSUCHE_INDEX_PREFIX=entscheidsuche.v2-

# Öffentliche Ansichts-URL eines Entscheids (Feld `url` der Treffer)
# ENTSCHEIDSUCHE_VIEW_URL=https://entscheidsuche.ch/view/

# URL für die Facetten-Hierarchie (Kanton/Gericht/Kammer)
ENTSCHEIDSUCHE_FACETS_URL=https://entscheidsuche.ch/docs/Facetten.json

# Transport: streamable-http | sse | stdio
MCP_TRANSPORT=streamable-http

# HTTP-Server
HOST=127.0.0.1
PORT=8765

# Pfad-Präfix unter dem die MCP-Endpunkte erreichbar sind (Default /mcp)
MCP_PATH=/mcp

# Oeffentliche Basis-URL fuer Server Card und .well-known-Endpunkte
PUBLIC_BASE_URL=https://mcp.entscheidsuche.ch

# Streamable HTTP ohne serverseitige Session-Pflicht
MCP_STATELESS_HTTP=true

# JSON-Response-Modus für POST /mcp.
# True (Default): einzelne JSON-Antwort statt SSE-Stream — auch Clients, die
#   nur "application/json" im Accept-Header senden, werden akzeptiert.
# False: spec-strikt, Accept muss beides enthalten (application/json +
#   text/event-stream). Empfohlen nur, wenn Streaming-Werkzeuge eingesetzt
#   werden — der entscheidsuche-Server liefert ausschließlich
#   Request/Response-Tools.
MCP_JSON_RESPONSE=true

# DNS-Rebinding-Schutz: blockiert Requests mit fremdem Host- oder Origin-Header.
# Standardmässig sind 127.0.0.1, localhost und der Host aus PUBLIC_BASE_URL erlaubt;
# zusätzliche Hostnamen / Origins können hier kommagetrennt ergänzt werden.
# MCP_DNS_REBINDING_PROTECTION=false schaltet die Prüfung komplett ab.
MCP_DNS_REBINDING_PROTECTION=true
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=

# Loglevel (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Request-Timeout für die Anfragen an die Such-API in Sekunden
HTTP_TIMEOUT=30

# TLS-Zertifikatsprüfung für Such-API und Facetten-Datei
# Für korrekt signierte Zertifikate auf "true" lassen.
ENTSCHEIDSUCHE_VERIFY_SSL=true

# CORS: "*" für beliebige Browser-Origin oder kommaseparierte Liste
# Beispiel: https://mcp.entscheidsuche.ch,https://app.example.com
CORS_ALLOW_ORIGINS=*

# ------------------------------------------------------------------
# JSON-RPC Access-Log (Nutzungsstatistik)
# ------------------------------------------------------------------
# Aktiviert die ASGI-Middleware, die jede MCP-Methode/Tool-Aufruf einzeln loggt.
ESC_ACCESS_LOG=true
# Tool-Argumente (die Suchanfragen der Nutzer) protokollieren? "false" lässt
# sie ganz weg; das Feld args= bleibt dann leer. Ohne Angabe: true.
ESC_ACCESS_LOG_ARGS=false
# Maximale Zeichen pro args-Repräsentation in der Logzeile, wenn die Argumente
# protokolliert werden (Default 200; 0 = args ebenfalls weglassen).
# ESC_ACCESS_LOG_ARGS_MAX=200
# Nur voruebergehend fuer Tests: Kennung der Unterhaltung (gehasht) als Feld
# conv= mitprotokollieren, sofern der Client eine mitschickt (ChatGPT). Damit
# lassen sich alle Aufrufe einer Unterhaltung zusammenfuehren.
ESC_ACCESS_LOG_SESSION=false
# Pfad fuer das Access-Log. Default: /var/log/entscheidsuche-mcp/access.log
# ESC_ACCESS_LOG_FILE=/var/log/entscheidsuche-mcp/access.log

# ------------------------------------------------------------------
# Statistik-Seite (/statistik) — Live-Generierung + JSON-Tagescache
# ------------------------------------------------------------------
# Pfad fuer den JSON-Cache der Vortage. Default: /var/lib/entscheidsuche-mcp/stats-cache.json
# ESC_STATS_CACHE=/var/lib/entscheidsuche-mcp/stats-cache.json
# Basic Auth: BEIDE setzen, sonst ist /statistik offen.
# ESC_STATS_USER=admin
# ESC_STATS_PASS=CHANGEME
