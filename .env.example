# Elasticsearch-Endpunkt von entscheidsuche.ch
ENTSCHEIDSUCHE_ES_URL=https://entscheidsuche.pansoft.de:9200/entscheidsuche.v2-*/_search

# URL für die Facetten-Hierarchie (Kanton/Gericht/Kammer)
ENTSCHEIDSUCHE_FACETS_URL=https://www.recherche.histoirerurale.ch/Facetten.json

# HTTP-Server
HOST=127.0.0.1
PORT=8765

# Pfad-Präfix unter dem die MCP-Endpunkte erreichbar sind (Default /mcp)
MCP_PATH=/mcp

# Oeffentliche Basis-URL fuer Server Card und .well-known-Endpunkte
PUBLIC_BASE_URL=https://mcp.entscheidsuche.ch

# Streamable HTTP ohne serverseitige Session-Pflicht
MCP_STATELESS_HTTP=true

# Loglevel (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Request-Timeout für die Elasticsearch-Anfragen in Sekunden
HTTP_TIMEOUT=30

# TLS-Zertifikatsprüfung für den Elasticsearch-/Facetten-Upstream
# Für korrekt signierte Zertifikate auf "true" lassen.
ENTSCHEIDSUCHE_VERIFY_SSL=true

# CORS: "*" für beliebige Browser-Origin oder kommaseparierte Liste
# Beispiel: https://mcp.entscheidsuche.ch,https://app.example.com
CORS_ALLOW_ORIGINS=*
